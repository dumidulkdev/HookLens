# Copy to .env at the repository root. Replace the local development password.
POSTGRES_USER=hooklens
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=hooklens
# Optional: override the npm registry used during Docker image builds if the default is unreachable.
# NPM_CONFIG_REGISTRY=https://registry.yarnpkg.com
DATABASE_URL=postgresql://hooklens:replace-with-a-local-password@localhost:5432/hooklens?schema=public
# Create this separate database before running integration tests. Never point at production.
TEST_DATABASE_URL=postgresql://hooklens:replace-with-a-local-password@localhost:5432/hooklens_test?schema=public
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
# The default trusts only the direct TCP peer. No forwarded headers are trusted.
CAPTURE_RATE_LIMIT=120
CREATE_RATE_LIMIT=10
# Frontend API origin; never put a management token here.
VITE_API_URL=http://localhost:3000
